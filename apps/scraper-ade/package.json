{
    "name": "@studysuite/scraper-ade",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "scrape": "tsx src/index.ts --once",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@studysuite/db": "workspace:*",
        "@studysuite/shared": "workspace:*",
        "zod": "^3.24.4"
    },
    "devDependencies": {
        "@studysuite/tsconfig": "workspace:*",
        "@types/node": "^22.15.18",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "vitest": "^5.0.0"
    }
}
