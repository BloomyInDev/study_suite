{
    "name": "study-suite",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm -r --parallel dev",
        "build": "pnpm -r build",
        "lint": "eslint .",
        "format": "prettier --write apps packages \"*.{json,md,yaml,yml}\" .prettierrc",
        "typecheck": "pnpm -r typecheck"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ],
        "overrides": {
            "hono": "^4.12.21"
        }
    },
    "devDependencies": {
        "@eslint/js": "^9.27.0",
        "eslint": "^9.27.0",
        "prettier": "^3.5.3",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.1"
    }
}
