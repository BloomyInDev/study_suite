{
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "paths": {
            "@studysuite/shared": ["./packages/shared/src/index.ts"],
            "@studysuite/shared/config": ["./packages/shared/src/config/index.ts"],
            "@studysuite/shared/time": ["./packages/shared/src/time/index.ts"],
            "@studysuite/shared/legal": ["./packages/shared/src/legal.ts"],
            "@studysuite/shared/color": ["./packages/shared/src/color/index.ts"],
            "@studysuite/shared/hidden-courses": ["./packages/shared/src/hidden-courses.ts"],
            "@studysuite/shared/reminders": ["./packages/shared/src/reminders.ts"],
            "@studysuite/db": ["./packages/db/src/index.ts"]
        }
    }
}
